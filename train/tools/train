PEAK_LR=1e-4; DECAY_LR=1e-4; DROP_N_LAST=""; LOG_FREQ=100
STEPS_GIVEN=false; BATCH_GIVEN=false; GRAD_ACCUM_GIVEN=false; WARMUP_GIVEN=false
PEAK_LR_GIVEN=false; DECAY_LR_GIVEN=false; DROP_N_LAST_GIVEN=false
