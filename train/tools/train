#!/usr/bin/env bash
# tools/train — π0.5 LoRA を container で学習する。
#
# 抜き出し元（本選1 の 5090 学習 script、113 行）と経緯は work/tools-train/extract.md。
# 2026-09-23 に Pro6000（切り離し起動・再開・言語 block・alpha・W&B online）を足した。
# 経緯は work/tools-train/pro6000-resume.md、差の測定は work/tools-train/pro6000-gap.md。
# **新しい引数を渡さなければ、container の引数列は抽出元と 1 文字も変わらない。**
# packet 固有の値（出力先・dataset・base・staging・repo_id・container 名・job 名・image・timeout）を
# 引数へ出し、BLOCKS の regex と期待値と rank を設定ファイル（既定 tools/train-blocks.tsv）へ出した。
# **呼ぶ 2 本は写していない。**expected_block_trainable.py（起動前の numel）と
# check_adapter_modules.sh（学習後の adapter の module 数）を、そのまま呼ぶ。
#
# packet 名・lane 名・日付・課題名・repo_id・staging の path をこの file の中に持たない。
#
# 実際に学習するときは runner を通す（門: RUN_JOB_GUARD=1 が無ければ exit 2）:
#   scripts/run_job.sh <名前> --proof 'TRAIN_START' --proof-timeout 900 \
#       --proof-file <out-root>/<id>/arm.log -- tools/train --id <id> ...
# --dry-run は門を通さずに検査だけを行い、組んだ引数列を stdout に出す（docker を起動しない）。
#
# 出力（--out-root と --id から道具が決める。既にあれば止まる。--resume のときは既にあること）:
#   <out-root>/<id>/arm.log        節目（TRAIN_START / TRAIN_FAIL / TRAIN_DONE）と adapter 検査
#   <out-root>/<id>/train.log      lerobot-train の生ログ（loss はここ。名前は --log-name）
#   <out-root>/<id>/manifest.json  入力の sha・道具の版・引数・container の引数列
#                                  （--resume のときは manifest-resume-<再開元の step>.json）
#   <out-root>/<id>/train-output/  checkpoints（container の /run/train-output）
#   --detach のときは更に:
#   <out-root>/<id>/<container 名>.rc   container 自身が書いた終了コード。**消さない**
#   <out-root>/<id>/containers.tsv      起動した container の一覧（起動の直前に書く）
#   <out-root>/<id>/container-exits.tsv 回収した終了コード
#
# **この道具が見ないもの**（呼ぶ側の責任）:
#   - 走行中の見張り。num_learnable_params・OOM・非有限値は見ない。
#     **Pro6000 で回すときは scripts/train_pro6000_canonical.sh の observe_guard を一緒に走らせる。**
#     再開で adapter が凍ったまま走る事故を本番で捕まえるのはこの見張りだけ。
#   - 再開先の checkpoint が読めるか。先に
#     `scripts/train_pro6000_canonical.sh --verify-checkpoints` と `--load-test` を回す。
#   - 出力先が揮発する置き場かどうか。**終了コードの file が残るのは、揮発しない側に
#     --out-root を置いたときだけ。**node ごと止まれば揮発側は消える。
#   - 回収のとき docker には訊かない（rc file だけを読む）。走ったままの container は見つけない。
set -Eeuo pipefail

TOOL_TAG=train
# runner は script を snapshot へ複製して走らせる。snapshot の隣に lib/ は無いので、そのときだけ元の path
# （RUN_JOB_SCRIPT）から辿る。別の script の中から呼ばれたときは RUN_JOB_SCRIPT がその script を指すので使わない
TOOL_DIR=$(cd "$(dirname "$0")" && pwd)
[ -f "$TOOL_DIR/lib/common.sh" ] || TOOL_DIR=$(cd "$(dirname "${RUN_JOB_SCRIPT:?lib/common.sh が見つからない}")" && pwd)
. "$TOOL_DIR/lib/common.sh"

usage() {
  cat <<'USAGE'
usage: tools/train --id <id> --blocks <name> --dataset <dir> --base <dir> --out-root <dir>
                   --inventory <file> --staging <dir> --repo-id <s> [options] [--dry-run]

必須:
  --id <id>              出力先の名前。<out-root>/<id> になる
  --blocks <name>        解凍する block。--blocks-config の 1 列目（既定の設定では D|V|VA|VD|VMDLmL|M）
  --dataset <dir>        staged dataset。container の /staging/dataset
  --base <dir>           土台の重み。container の /base（--policy.pretrained_path）
  --out-root <dir>       出力の根。<id> をこの下に作る
  --inventory <file>     module inventory。起動前に BLOCKS の numel を突き合わせる
  --staging <dir>        lerobot と HF cache を持つ dir（<staging>/lerobot と <staging>/data/hf を mount）
  --repo-id <s>          --dataset.repo_id

任意（既定は抽出元と同じ）:
  --steps N              800（--policy.scheduler_decay_steps も同じ値）
  --batch N              6（物理 batch）
  --grad-accum N         21（container へ LEROBOT_GRAD_ACCUM で渡す）
  --seed N               1000
  --save-freq N          200
  --warmup N             20
  --peak-lr X            1e-4（--dpo のときの既定は 2.5e-5。--decay-lr と両方渡したときだけ、その値）
  --decay-lr X           1e-4（peak と同値 = warmup 後は定数 lr。--dpo のときの既定は 2.5e-6。--peak-lr と両方渡したときだけ、その値）
  --log-freq N           100（--log_freq）
  --image NAME           parc2026:latest
  --timeout DUR          6h（timeout(1) の書式。--detach とは同時に渡せない）
  --container-name S     train-<id>
  --job-name S           <id>-<steps>
  --log-name S           train.log（container が書く生ログの名前）
  --blocks-config FILE   tools/train-blocks.tsv
  --trainable-script F   scripts/expected_block_trainable.py（repo 根から。写さず呼ぶ）
  --check-script F       scripts/check_adapter_modules.sh（repo 根から。写さず呼ぶ）
  --dpo                  DPO entry 用設定（--entry dpo_training_entry.py と --blocks D が要る）
  --dpo-beta X           DPO beta（既定 200。--dpo のときだけ）
  --dpo-lambda X         安全側 SFT 項の重み（既定 20。--dpo のときだけ）
  --dpo-steps N          DPO step 数（既定 1,200。launcher の --steps に自動反映し、明示値との不一致は拒否）
  --dry-run              検査だけ行い、docker の引数列を 1 行 1 引数で stdout に出す。門を通さない
  --help

渡したときだけ効く（渡さなければ container の引数列は抽出元と 1 文字も変わらない）:
  --drop-n-last N|none   --policy.drop_n_last_frames=N。none ならこの欄を出さない（= pi05 の既定 49）。
                         **必須。**渡し忘れると 0 のつもりが 49 で走るので、道具が止める
                         （出さないと pi05 の既定 49 で走る。抽出元は 0 なので 0 を明示する）
  --save-checkpoint B    --save_checkpoint=B（true|false）
  --rank N               --blocks-config の rank 欄との照合用。違えば起動前に止まる
  --allow-language-blocks  regex に language_model が入っていても通す（既定は止める）
  --alpha N              LEROBOT_LORA_ALPHA。CLI に欄が無いので環境変数で渡す。--entry が要る
  --entry FILE           入口の .py。<FILE の dir> を /runtime:ro に mount し、
                         /staging/lerobot/.venv/bin/python /runtime/<FILE の名前> を叩く。
                         HOME=/tmp/home と HF_LEROBOT_HOME=/tmp/lerobot-home も付く。--alpha が要る
  --snapshot-src DIR     staging の symlink が指す HF snapshot の path に mount する元
  --snapshot-dest PATH   その mount 先（container の中の path）。--snapshot-src と両方渡す。
                         **--detach のときだけ mount される**ので、--detach なしでは止める
  --exclude-episodes F   学習に使わない episode の一覧（json。tools/stage の --exclude-episodes と同じ形:
                         {"episodes": [{"episode_index": N, ...}, ...]}）。dataset の meta/info.json の
                         total_episodes から一覧の番号を除いた残りを <out>/episodes-used.json に書き、
                         LEROBOT_TRAIN_EPISODES_JSON で入口に渡す。入口（tools/train-entry/train_entry.py）が
                         学習の sampler の始点をその episode だけにする。**--entry が要る。**
                         lerobot の --dataset.episodes は使わない（この版では sampler と噛み合わず落ちる）
  --lr-groups F          学習率の群の設定（json。{"groups": [{"name", "regex", "lr", "expect_numel"}, ...]}）。
                         渡すと、学習する LoRA を module 名の正規表現で群に分け、群ごとの学習率で学習する
                         （LEROBOT_LR_GROUPS_JSON=/run/lr-groups.json で入口に渡す。設定の写しを <out>/lr-groups.json に置く）。
                         起動の前に、設定を inventory で照合する（群が --blocks の module をちょうど 1 回ずつ分ける・
                         群ごとの parameter 数が expect_numel と一致・合計が --blocks の期待値と一致・
                         最も大きい群の lr が --peak-lr と一致）。合わなければ出力先を作る前に止まる。
                         **渡さなければ container の引数列は 1 文字も変わらない**（群 1 つ。lerobot の既定）。
                         --entry tools/train-entry/train_entry.py が要る。--resume では元の学習と同じ設定を渡す
  --wandb PROJ:RUN_ID    W&B を online で使う。--network bridge にし、環境変数の許可リストを付ける。
                         **WANDB_MODE は出さない**（環境変数が CLI より強く、online が黙って落ちる）
  --detach               切り離して起動する（docker run -d、--rm を付けない、container の中で tee -a、
                         終了コードを container 自身が <container 名>.rc に書く）。
                         **container の形が変わる**（環境変数の並び・WANDB_MODE を出さない・mount の並び）。
                         runner や SSH が死んでも学習とログが続く。--timeout は効かないので拒否する
  --resume               落ちた所から再開する。--entry が要る（無いと adapter が凍って
                         学習する parameter が 0 個になる）。出力先が既にあり、
                         train-output/checkpoints/last があることを要求する。
                         container 名は <container 名>-resume-<再開元の step> になる。
                         学習器へ渡すのは --config_path / --resume=true / --peft=null の 3 つだけ

--dpo の既定は action block D（128 module / rank 8 / alpha 8）、batch 32、grad-accum 1、
50-action chunk、float32、gradient checkpointing、drop-n-last 0、
warmup=min(200, floor(0.1 * steps))、peak LR 2.5e-5、decay LR 2.5e-6、
beta 200、lambda 20、steps 1,200。物理 batch × gradient accumulation は
32×1（既定）、16×2、8×4 だけ（有効 batch は32、各物理 batch は完全な対を含む）。
beta・lambda・steps 以外の設定は DPO entry の実効値と食い違う指定を拒否する。
USAGE
}

